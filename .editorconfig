root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.{json,yml,yaml,mjs}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
