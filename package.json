{
  "name": "codex-dream-skin-manager-shared",
  "private": true,
  "engines": { "node": ">=22.22.2 <23" },
  "scripts": {
    "build:core": "tsc -p tsconfig.core.json",
    "build:ui": "vite build --config ui/manager/vite.config.mts",
    "check:ui": "tsc -p ui/manager/tsconfig.json",
    "test:shared": "npm run build:core && node --test tests/shared-manager.test.mjs tests/shared-library-transactions.test.mjs tests/shared-library-worker.test.mjs tests/shared-opacity-refresh.test.mjs",
    "manager:read": "node build/shared/core/main.mjs"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/node": "22.10.5",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
